{
  "name": "@peasant-labs/types",
  "version": "0.0.0",
  "description": "Shared, framework-agnostic transcript types for AI agent session transcripts.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"

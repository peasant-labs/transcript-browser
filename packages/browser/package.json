{
  "name": "@peasant-labs/transcript-browser",
  "version": "0.0.7",
  "description": "Framework-agnostic React viewer for AI agent session transcripts.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/peasant-labs/transcript-browser",
    "directory": "packages/browser"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:initial-position:mutations": "node scripts/initial-position.mutations.mjs",
    "test:schema-boundary:mutations": "node scripts/schema-boundary.mutations.mjs",
    "test:provider-policy:mutations": "node scripts/provider-policy.mutations.mjs",
    "test:turn-alignment:mutations": "node scripts/turn-alignment.mutations.mjs",
    "test:package-provenance": "node scripts/package-provenance.test.mjs",
    "clean": "rm -rf dist",
    "prepack": "tsup"
  },
  "peerDependencies": {
    "@peasant-labs/fairtrade": "0.0.12",
    "@xyflow/react": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@xyflow/react": {
      "optional": true
    }
  },
  "dependencies": {
    "@peasant-labs/schema": "0.1.1",
    "clsx": "^2.1.1",
    "diff": "^7.0.0",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "shiki": "^1.24.4"
  },
  "devDependencies": {
    "@peasant-labs/fairtrade": "0.0.12",
    "@types/diff": "^7.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "@xyflow/react": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6",
    "yaml": "^2.7.0"
  }
}

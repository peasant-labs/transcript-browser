{
  "name": "@peasant-labs/transcript-browser",
  "version": "0.0.0",
  "description": "Framework-agnostic React viewer for AI agent session transcripts.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepack": "tsup && node scripts/workspace-devdeps.mjs strip",
    "postpack": "node scripts/workspace-devdeps.mjs restore"
  },
  "peerDependencies": {
    "@xyflow/react": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@xyflow/react": {
      "optional": true
    }
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "^7.0.0",
    "lucide-react": "^0.469.0",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "shiki": "^1.24.4"
  },
  "devDependencies": {
    "@peasant-labs/theme": "workspace:*",
    "@peasant-labs/types": "workspace:*",
    "@types/diff": "^7.0.0",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "@xyflow/react": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}

{
  "name": "@peasant-labs/analytics",
  "version": "0.0.0",
  "description": "Framework-agnostic React analytics layer (pure metric functions + ProjectOverview) for AI agent session data.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "prepack": "tsup && node scripts/workspace-devdeps.mjs strip",
    "postpack": "node scripts/workspace-devdeps.mjs restore"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@peasant-labs/fairtrade": "^0.0.3",
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@peasant-labs/types": "workspace:*",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}

{
  "name": "@peasant-labs/transcript-browser-monorepo",
  "version": "0.0.1",
  "private": false,
  "description": "Shared, framework-agnostic transcript browser for AI agent session transcripts.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm build && pnpm typecheck && pnpm test && pnpm gates && pnpm storybook:build && pnpm sbsmoke && pnpm fidelity",
    "contrast": "node scripts/contrast.mjs",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "gates": "pnpm contrast && node scripts/validate-theme.mjs && node scripts/assert-no-engine-deps.mjs",
    "storybook:build": "storybook build",
    "sbsmoke": "node scripts/sbsmoke.mjs",
    "fidelity": "node scripts/fidelity.mjs",
    "clean": "pnpm -r clean",
    "dev:minimal": "pnpm --filter @peasant-labs/example-minimal dev",
    "probe:tb": "node scripts/visual/probe-tb.mjs",
    "shoot:tb": "node scripts/visual/tb-shoot.mjs",
    "sxs": "node scripts/visual/stitch-sxs.mjs"
  },
  "devDependencies": {
    "@peasant-labs/fairtrade": "^0.0.5",
    "@peasant-labs/transcript-browser": "workspace:*",
    "@storybook/react-vite": "^10.4.6",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "@xyflow/react": "^12.0.0",
    "playwright": "^1.61.0",
    "puppeteer-core": "^25.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "storybook": "^10.4.6",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
